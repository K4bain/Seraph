# ------------------------------------------------------------------
# Meridian — environment configuration
# Copy to .env and fill in. Never commit .env.
# ------------------------------------------------------------------

# Database (relational + Apache AGE graph share the same instance)
DATABASE_URL=postgresql://meridian:password@localhost:5432/meridian
# AGE graph lives in the same Postgres; only override if you split instances
GRAPH_DATABASE_URL=postgresql://meridian:password@localhost:5432/meridian

# AGE graph import — when "true", confirmed canvas entities/edges are
# mirrored into the property graph after each ingest. Off by default
# (managed hosts like Neon cannot install the AGE extension).
ENABLE_GRAPH_IMPORT=false

# Redis (BullMQ queues, cross-node EventBus)
REDIS_URL=redis://localhost:6379
# Serverless TLS (Upstash etc.): rediss://default:<token>@<host>:6379

# Auth
# Generate with: openssl rand -hex 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AI
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Storage (MinIO — S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=meridian
S3_SECRET_KEY=meridian-secret-key
S3_BUCKET=meridian-assets
S3_USE_SSL=false

# Collab / realtime
WS_SERVER_URL=ws://localhost:3001
