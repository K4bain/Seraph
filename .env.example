# ------------------------------------------------------------------
# Seraph — environment configuration
# Copy to .env and fill in. Never commit .env.
# ------------------------------------------------------------------

# Database (relational + Apache AGE graph share the same instance)
DATABASE_URL=postgresql://seraph:password@localhost:5432/seraph
# AGE graph lives in the same Postgres; only override if you split instances
GRAPH_DATABASE_URL=postgresql://seraph:password@localhost:5432/seraph

# AGE graph import — when "true", confirmed canvas entities/edges are
# mirrored into the property graph after each ingest. Off by default
# (managed hosts like Neon cannot install the AGE extension).
ENABLE_GRAPH_IMPORT=false

# Redis (BullMQ queues, cross-node EventBus)
REDIS_URL=redis://localhost:6379
# Serverless TLS (Upstash etc.): rediss://default:<token>@<host>:6379

# Auth
# Generate with: openssl rand -hex 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AI (OpenRouter)
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model id — anything OpenRouter serves, e.g. "anthropic/claude-sonnet-4.6",
# "openai/gpt-5", "deepseek/deepseek-chat"
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
VOYAGE_API_KEY=

# Storage (MinIO — S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=seraph
S3_SECRET_KEY=seraph-secret-key
S3_BUCKET=seraph-assets
S3_USE_SSL=false

# Collab / realtime
WS_SERVER_URL=ws://localhost:3001

# Globe lens (WorldWideView)
# Remote WorldWideView endpoint used by the /globe lens when self-hosting a
# full WWV instance; leave empty to use the embedded (in-repo) WWV globe.
NEXT_PUBLIC_WWV_URL=
# Country-borders GeoJSON source for the globe's borders layer (Natural Earth).
NEXT_PUBLIC_WWV_BORDERS_URL=https://raw.githubusercontent.com/nvkelso/natural-earth-vector/master/geojson/ne_110m_admin_0_countries.geojson
# WWV edition flag ("local" | "cloud" | "demo") — demo unlocks default plugins
# and demo-friendly gates without requiring a database.
NEXT_PUBLIC_WWV_EDITION=demo
