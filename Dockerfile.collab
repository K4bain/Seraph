# ================================================================
# Seraph collab server — Yjs WebSocket presence daemon.
# Mirrors `pnpm collab:server` (@y/websocket-server devDependency).
#
# Railway builds this service with context = services/collab (the
# service root directory), so repo-root files are unreachable via COPY.
# The Dockerfile.age trick of avoiding COPYs (heredocs only) doesn't
# work here — the collab server needs the full workspace install. Clone
# the repo instead; builds have outbound network on Railway.
# ================================================================

FROM node:24-alpine
RUN corepack enable && apk add --no-cache git
WORKDIR /app

RUN git clone --depth 1 --branch master https://github.com/K4bain/Seraph.git .
RUN pnpm install --frozen-lockfile

ENV PORT=3001
ENV HOST=0.0.0.0
ENV NODE_ENV=production
EXPOSE 3001

CMD ["node", "node_modules/@y/websocket-server/src/server.js"]
