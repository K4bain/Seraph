# ================================================================
# Seraph connector worker — BullMQ consumer for connector runs.
# Bundles the full runtime (src/, workers/, prisma client) and starts
# `pnpm worker:connectors`.
#
# Built with context = repo root (service rootDirectory = "."), so
# everything is COPYed from the checked-out source — no build-time
# git clone, no stale-image surprises. Mirrors the app Dockerfile's
# deps-stage pattern.
# ================================================================

FROM node:24-alpine AS deps
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/seraph-graph-types/package.json packages/seraph-graph-types/package.json
COPY packages/seraph-connector-sdk/package.json packages/seraph-connector-sdk/package.json
COPY prisma/ prisma/
RUN pnpm install --frozen-lockfile

FROM node:24-alpine
RUN corepack enable
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages
COPY . .
# Prisma client is generated at install (postinstall); regenerate
# explicitly so the worker always ships a fresh client.
RUN pnpm db:generate

ENV NODE_ENV=production

CMD ["pnpm", "worker:connectors"]
