# ================================================================
# Seraph connector worker — BullMQ consumer for connector runs.
# Bundles the full runtime (src/, workers/, prisma client) and starts
# `pnpm worker:connectors`.
#
# Same context constraint as Dockerfile.collab: Railway builds this
# service with context = services/worker, so COPY from the repo root is
# impossible — clone the repo instead (builds have outbound network).
# ================================================================

FROM node:24-alpine
RUN corepack enable && apk add --no-cache git
WORKDIR /app

RUN git clone --depth 1 --branch master https://github.com/K4bain/Seraph.git .
RUN pnpm install --frozen-lockfile
# Prisma client is generated at install (postinstall); regenerate
# explicitly so the worker always ships a fresh client.
RUN pnpm db:generate

ENV NODE_ENV=production

CMD ["pnpm", "worker:connectors"]
