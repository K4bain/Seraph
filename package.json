{
  "name": "seraph",
  "version": "0.1.0",
  "private": true,
  "description": "Seraph — find anyone, map everything, stay informed. Search-first OSINT fusion: one query across OpenSanctions, SEC EDGAR, GDELT, Wikidata, WHOIS and GitHub, then map it on graph canvases.",
  "license": "Apache-2.0",
  "keywords": [
    "osint",
    "open-source-intelligence",
    "investigation",
    "graph",
    "canvas",
    "sanctions",
    "gdelt",
    "sec-edgar",
    "wikidata",
    "whois",
    "opensanctions",
    "intelligence-platform",
    "nextjs",
    "react-flow"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@8.14.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && node -e \"if (require('fs').existsSync('scripts/copy-cesium.mjs')) require('child_process').execSync('node scripts/copy-cesium.mjs', { stdio: 'inherit' })\"",
    "copy:cesium": "node scripts/copy-cesium.mjs",
    "worker:connectors": "tsx workers/connector-runner.ts",
    "worker:ai": "tsx workers/ai-processor.ts",
    "collab:server": "node node_modules/@y/websocket-server/src/server.js",
    "test": "vitest run"
  },
  "dependencies": {
