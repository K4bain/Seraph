{
  "name": "meridian-connector-sdk",
  "version": "0.1.0",
  "description": "Typed connector authoring SDK for Meridian. Write a connector, emit EntityStreamEvents, feed the graph.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "types": "./src/runtime.ts",
      "default": "./src/runtime.ts"
    }
  },
  "files": ["src"],
  "dependencies": {
    "meridian-graph-types": "workspace:*"
  }
}
