// ================================================================
// Seraph — relational schema (Prisma)
//
// Relational layer: identity, auth, workspaces, canvas documents.
// The graph itself (entities/relationships) lives in Apache AGE
// on the same Postgres instance — see prisma/graph/age-init.sql
// and src/core/graph/age.ts.
// ================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (Auth.js compatible shapes) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   WorkspaceMember[]
  canvases      Canvas[]    @relation("CanvasOwner")
  snapshots     CanvasSnapshot[] @relation("SnapshotAuthor")
  shares        Share[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Workspaces ----------

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model Workspace {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  ownerId      String?
  locked       Boolean           @default(false)
  lockedReason String?
  lockedAt     DateTime?
  createdAt    DateTime          @default(now())
  members      WorkspaceMember[]
  canvases     Canvas[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// ---------- Canvases ----------

model Canvas {
  id          String           @id @default(cuid())
  workspaceId String
  title       String
  description String?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("CanvasOwner", fields: [createdById], references: [id])
  snapshots   CanvasSnapshot[]
  shares      Share[]

  @@index([workspaceId])
}

/// Versioned document snapshot (canvas export schema payload).
/// Full Yjs CRDT document history lands in Phase 2; the snapshot
/// table anchors the audit trail and "rewind" feature.
model CanvasSnapshot {
  id         String   @id @default(cuid())
  canvasId   String
  version    Int
  document   Json
  createdById String?
  createdAt  DateTime @default(now())
  canvas     Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  createdBy  User?    @relation("SnapshotAuthor", fields: [createdById], references: [id])

  @@unique([canvasId, version])
}

// ---------- API keys (MCP / programmatic access) ----------

/// Machine credential for the MCP endpoint and future API surface.
/// Only an HMAC hash of the key is stored; the plaintext `seraph_...`
/// key is shown exactly once at creation.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([revokedAt])
}

// ---------- Share links ----------

/// Read-only share token for a canvas (Phase 5). The token is the
/// capability: anyone holding the URL can view the latest snapshot.
model Share {
  token     String   @id
  canvasId  String
  createdById String?
  createdAt DateTime @default(now())
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@index([canvasId])
}

// ---------- Search + watchlist ----------

/// One entry per search run — powers the "recent searches" UX and
/// lets the platform know which queries are being asked.
model SearchHistory {
  id        String   @id @default(cuid())
  userId    String?
  query     String
  type      String?
  results   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// A term the user wants to monitor for new mentions.
model WatchlistItem {
  id        String           @id @default(cuid())
  userId    String?
  term      String
  type      String?
  lastCheck DateTime?
  createdAt DateTime         @default(now())
  alerts    WatchlistAlert[]

  @@index([userId])
}

/// A new mention of a watchlist term found by the poll worker.
model WatchlistAlert {
  id          String        @id @default(cuid())
  watchlistId String
  watchlist   WatchlistItem @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  headline    String
  source      String
  url         String?
  tone        Float?
  read        Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([watchlistId, read])
}

// ---------- WorldWideView port (marketplace, orgs, tiers, keys) ----------
// Model names/shapes mirror the ORIGINAL WWV-era production schema (the live
// Neon DB): every model below carries the exact @@map + column shape of the
// table it reads/writes. Do not rename fields used by src/wwv code.

/// A plugin installed from the Worldwide View marketplace.
/// (original table: installed_plugins)
model InstalledPlugin {
  id          String   @id @default(cuid())
  tenantId    String?
  pluginId    String
  version     String
  config      String   @default("{}")
  enabled     Boolean  @default(true)
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("installed_plugins")
}

/// Key/value settings store (default-plugins guard etc.).
/// (original table: settings)
model Setting {
  id       String  @id @default(cuid())
  tenantId String?
  key      String
  value    String

  @@map("settings")
}

/// WWV data-API keys. `prefix` is the plaintext lookup handle; the key
/// itself is only ever stored as an HMAC hash (T-16-01).
/// (original table: user_api_keys)
model UserApiKey {
  id           String    @id @default(cuid())
  userId       String
  tenantId     String?
  prefix       String    @unique
  hashedSecret String
  name         String    @default("")
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@map("user_api_keys")
}

/// One-time setup token (SHA-256 hash stored, raw shown once).
/// (original table: setup_tokens)
model SetupToken {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String
  organizationId String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@map("setup_tokens")
}

/// Organization membership used for tiered access + tenant isolation.
/// (original table: member)
model PluginMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  @@map("member")
}

/// Billing / access tier attached to an organization.
/// (original table: org_tiers)
model OrgTier {
  id             String    @id @default(cuid())
  organizationId String    @unique
  tier           String    @default("free")
  status         String    @default("active")
  trialEndsAt    DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  @@map("org_tiers")
}

/// Encrypted marketplace credential (AES-256-GCM; PKCE exchange).
/// (original table: marketplace_credentials)
model MarketplaceCredential {
  id         String   @id @default(cuid())
  tenantId   String?  @unique
  version    String
  salt       String
  nonce      String
  ciphertext String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("marketplace_credentials")
}

/// Better Auth user (WWV-era). Lives in the ACTIVE auth table.
/// (original table: user)
model BetterAuthUser {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("user")
}

/// Better Auth account (WWV-era). Passwords live here (providerId "credential").
/// (original table: account)
model BetterAuthAccount {
  id        String    @id
  userId    String
  accountId String
  providerId String
  password  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("account")
}

/// LEGACY pre-Better-Auth user (bcrypt hashedPassword). Read-only in the
/// port: used by the legacy-user migration to verify old logins.
/// (original table: users)
model LegacyUser {
  id             String    @id
  email          String    @unique
  name           String
  hashedPassword String
  role           String    @default("user")
  createdAt      DateTime  @default(now())
  sessionVersion Int       @default(0)

  @@map("users")
}
