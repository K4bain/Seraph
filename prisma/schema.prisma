// ================================================================
// Seraph — relational schema (Prisma)
//
// Relational layer: identity, auth, workspaces, canvas documents.
// The graph itself (entities/relationships) lives in Apache AGE
// on the same Postgres instance — see prisma/graph/age-init.sql
// and src/core/graph/age.ts.
// ================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (Auth.js compatible shapes) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   WorkspaceMember[]
  canvases      Canvas[]    @relation("CanvasOwner")
  snapshots     CanvasSnapshot[] @relation("SnapshotAuthor")
  shares        Share[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Workspaces ----------

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model Workspace {
  id        String            @id @default(cuid())
  slug      String            @unique
  name      String
  createdAt DateTime          @default(now())
  members   WorkspaceMember[]
  canvases  Canvas[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(VIEWER)
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

// ---------- Canvases ----------

model Canvas {
  id          String           @id @default(cuid())
  workspaceId String
  title       String
  description String?
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User             @relation("CanvasOwner", fields: [createdById], references: [id])
  snapshots   CanvasSnapshot[]
  shares      Share[]

  @@index([workspaceId])
}

/// Versioned document snapshot (canvas export schema payload).
/// Full Yjs CRDT document history lands in Phase 2; the snapshot
/// table anchors the audit trail and "rewind" feature.
model CanvasSnapshot {
  id         String   @id @default(cuid())
  canvasId   String
  version    Int
  document   Json
  createdById String?
  createdAt  DateTime @default(now())
  canvas     Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  createdBy  User?    @relation("SnapshotAuthor", fields: [createdById], references: [id])

  @@unique([canvasId, version])
}

// ---------- API keys (MCP / programmatic access) ----------

/// Machine credential for the MCP endpoint and future API surface.
/// Only an HMAC hash of the key is stored; the plaintext `seraph_...`
/// key is shown exactly once at creation.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([revokedAt])
}

// ---------- Share links ----------

/// Read-only share token for a canvas (Phase 5). The token is the
/// capability: anyone holding the URL can view the latest snapshot.
model Share {
  token     String   @id
  canvasId  String
  createdById String?
  createdAt DateTime @default(now())
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@index([canvasId])
}

// ---------- Search + watchlist ----------

/// One entry per search run — powers the "recent searches" UX and
/// lets the platform know which queries are being asked.
model SearchHistory {
  id        String   @id @default(cuid())
  userId    String?
  query     String
  type      String?
  results   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// A term the user wants to monitor for new mentions.
model WatchlistItem {
  id        String           @id @default(cuid())
  userId    String?
  term      String
  type      String?
  lastCheck DateTime?
  createdAt DateTime         @default(now())
  alerts    WatchlistAlert[]

  @@index([userId])
}

/// A new mention of a watchlist term found by the poll worker.
model WatchlistAlert {
  id          String        @id @default(cuid())
  watchlistId String
  watchlist   WatchlistItem @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  headline    String
  source      String
  url         String?
  tone        Float?
  read        Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([watchlistId, read])
}
