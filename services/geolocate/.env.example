# CLIP model checkpoint used to embed images.
CLIP_MODEL=openai/clip-vit-base-patch32

# Path to the FAISS index file (built by scripts/build_index.py).
INDEX_PATH=data/index.faiss

# Path to the metadata JSON mirroring the index (lat/lon per vector).
META_PATH=data/meta.json

# Port the FastAPI service listens on.
PORT=8000

# Optional: reverse-geocoding API key (e.g. OpenCage) for richer results.
REVERSE_GEO_KEY=
