{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "preserve",
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
"paths": {
      "@/*": [
        "./src/*"
      ],
      "@worldwideview/wwv-plugin-sdk": [
        "./packages/wwv-plugin-sdk/src"
      ],
      "@worldwideview/wwv-lib-aviation": [
        "./packages/wwv-lib-aviation/src"
      ],
      "@worldwideview/wwv-lib-incidents": [
        "./packages/wwv-lib-incidents/src"
      ]
    },
    "allowJs": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../packages/*/src/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
